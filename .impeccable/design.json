  "narrative": {
    "northStar": "The Holiday Blanket",
    "overview": "The page is a hwatu table: a blanket-red ground woven with a faint flat twill, a deeper red board set into it, and real-proportion (5:7) cards lying on top. Everything that is not a card is flat. Tone steps do the work gradients would do, and the only shadows in the system belong to the cards, because cards are the only physical objects on the table.",
    "keyCharacteristics": [
      "One red ground, one deeper board red, near-black ink, one gold accent.",
      "Flat fills; no gradients. Cards are the only elevated things.",
      "4px ink border on card faces, 4px radius on every surface.",
      "All art is drawn SVG; no raster images, no emoji.",
      "Motion is physical: deal, flip, press flat, sweep."
    ],
    "rules": [
      {
        "name": "The Gold Is The Only Accent Rule",
        "body": "Gold marks what the player acts on or has earned. Month colours never leave the card faces.",
        "section": "colors"
      },
      {
        "name": "The No-Gradient Rule",
        "body": "Surfaces are flat fills; the twill is a two-tone pattern, not a gradient.",
        "section": "colors"
      },
      {
        "name": "The One Heavy Face Rule",
        "body": "Black Han Sans is for the title, numbers and win text only; sentences are always in the body sans.",
        "section": "typography"
      },
      {
        "name": "The Only Cards Cast Rule",
        "body": "Shadows belong to cards. Buttons, panels, rows and the board stay flat.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the ground blanket red and let gold be the single accent.",
      "Do use 4px radius everywhere and a 4px ink border on card faces.",
      "Do draw art as flat SVG in white and ink on a flat month colour.",
      "Do give new interactive elements the global 4px gold focus outline.",
      "Do disable motion under prefers-reduced-motion."
    ],
    "donts": [
      "Don't use gradients, glows or pastel tints for surfaces.",
      "Don't add shadows to anything that is not a physical card.",
      "Don't use emoji or icon glyphs as art; draw it.",
      "Don't let month colours appear outside card faces.",
      "Don't set sentences in Black Han Sans."
    ]
  }
}